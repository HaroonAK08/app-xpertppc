{
  "name": "lead-saas",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "corepack pnpm --parallel --filter './apps/*' dev",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "db:generate": "corepack pnpm --filter @lead-saas/database prisma generate",
    "db:migrate": "corepack pnpm --filter @lead-saas/database prisma migrate dev"
    ,"load:api":"node infra/scripts/load-api.mjs"
    ,"load:webhook":"node infra/scripts/load-webhook.mjs"
  }
}
